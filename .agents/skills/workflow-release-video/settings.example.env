# workflow-release-video settings — copy to $VIDEO_DIR/settings.env and edit.
# Defaults are the ones this skill ships with: the same approved voice and mascot as the
# PR video tours, a ~4 minute budget, and a GitHub Release asset as the destination.

# ── what release ─────────────────────────────────────────────────────────────
REPO="${REPO:?set REPO to the repository to narrate}"
RELEASE_FROM=""                 # tag / branch / sha; empty = newest tag reachable from TO
RELEASE_TO="HEAD"
RELEASE_TAG=""                  # the GitHub release to publish to; empty = RELEASE_FROM
PRODUCT_NAME=""                 # "Acme"; empty = the repo directory name
VIDEO_DIR="${VIDEO_DIR:-$REPO/.release-video}"   # NEVER /tmp — a tmp-cleaner wiped a run

# ── the budget (see SKILL.md) ─────────────────────────────────────────────────
TARGET_SECONDS="244"            # 230–260 is the honest band; the rendered voice decides
MIN_SECONDS="200"               # below this, ship the shorter video — do not pad
MAX_SECONDS="290"               # above this, cut a chapter — do not trim speech
CHAPTERS="8"                    # 7–9
CARDS="9"                       # 8 dividers + the close
FILM_BEATS="16"                 # 2 per chapter; 14–18
TOTAL_WORDS_MIN="460"            # seconds ≈ total words / 2.5 + 44
TOTAL_WORDS_MAX="540"
WORDS_PER_BEAT_MIN="18"
WORDS_PER_BEAT_MAX="24"
WORDS_PER_SECOND="3.0"          # planning only; Alfie measures ~3.0 and never flat

# ── what to film ─────────────────────────────────────────────────────────────
APP_URL=""                      # http://localhost:5173 — empty = cards-only video
WEB_URL=""                      # optional 2nd surface (mail catcher, metrics, logs)
BEFORE_WORKTREE=""              # a worktree checked out at RELEASE_FROM, for the BEFORE beats
BEFORE_CMD=""                   # run once when the storyboard first enters phase "before"
AFTER_CMD=""                    # run once when the storyboard first enters phase "after"
CAPTURE_VIEWPORT="1600x900"
CAPTURE_FPS="30"
CAPTURE_SESSION="${CHROME_SESSION}"
CAPTURE_PROFILE="${CHROME_SESSION_PROFILE}"
LOGIN_EMAIL=""                  # local dev credentials; never a real account
LOGIN_PASSWORD=""

# ── narration (identical to workflow-video-tour: this IS the approved narrator) ──
TTS_BACKEND="phonon"
PHONON_VOICE="Alfie"            # the approved narrator (user pick 2026-10-26)
PHONON_HOST="http://127.0.0.1:11434"
PHONON_MODEL="phonon"
# Phonon: no style/speed/seed input; `voice` alone is the speaker. See
# workflow-video-tour/steps/3-narration.md for the runtime (Ollama >= 0.40.9 + MLX).
TTS_LOUDNESS="I=-16:TP=-1.5:LRA=11"

# ── avatar: on the CARDS only (see steps/6-avatar-music.md) ──────────────────
# A mascot bobbing for four minutes reads as a watermark. Over the intro, the dividers
# and the close it reads as a presenter.
AVATAR_ENABLED="1"
AVATAR_CARDS_ONLY="1"           # 0 → use the tour's whole-video overlay instead
AVATAR_MODE="svg"               # svg (the mascot) | pil | none
AVATAR_BLINK="1"
AVATAR_BOB="3"
AVATAR_SIZE="240"
AVATAR_CORNER="br"
AVATAR_CAPTION_BAND="88"
AVATAR_WINDOW_PAD="0.4"         # s of bleed around each card window; a hard cut looks like a glitch
AVATAR_FPS="30"

# ── music: always on, always licensed, and LONG ENOUGH ───────────────────────
# A 90 s loop is audibly looping by minute three. Check the track's length against
# TARGET_SECONDS before you start, not after.
MUSIC_FILE="~/.agents/skills/workflow-video-tour/assets/music/house.mp3"
MUSIC_BED_DB="-24"
MUSIC_DUCK="8"
MUSIC_ATTRIBUTION=""            # "Track — Artist · URL · Licence" → the release body

# ── publish ──────────────────────────────────────────────────────────────────
PUBLISH_TO="release"            # release | pr | desktop
ORG_REPO=""                     # empty = read from release-manifest.json (.repo.slug)
PUBLISH_CHAPTERS="1"

# ── local model paths ─────────────────────────────────────────────────────────
WHISPER_MODEL="$HOME/.local/share/voxtype/models/ggml-medium.en.bin"
