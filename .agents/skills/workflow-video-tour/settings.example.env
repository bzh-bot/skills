# workflow-video-tour settings — copy to $VIDEO_DIR/settings.env and edit.
# Defaults are the ones the skill ships with: a designed narration voice, the
# animated mascot, a licensed bed, a 4 s intro card.

# ── where ────────────────────────────────────────────────────────────────────
VIDEO_DIR="${VIDEO_DIR:-$WORKTREE/.workflow-video}"   # NEVER /tmp — a tmp-cleaner wiped a run
VIDEO_SLUG="${TICKET_ID}-${FEATURE_TAG}"              # e.g. ABC-45-example-feature
APP_URL="http://localhost:5173"                       # the app under test
WEB_URL=""                                            # optional 2nd surface (mail catcher, studio…)

# ── intro card (always on) ───────────────────────────────────────────────────
# storyboard.json .title  = "<TICKET> · PR #<N>"
# storyboard.json .subtitle = the ultra-brief title (≤ 6 words)
TITLE_SECONDS="4"

# ── diagrams (mandatory — see diagrams.md) ───────────────────────────────────
# Every tour opens with a concept/architecture diagram and, when the diff touches the
# data model, an ERD. Sources live in $VIDEO_DIR/diagrams/<beat-id>.mmd; the render is
# deterministic so one diagram can be re-rendered into a finished cut.
MERMAID_CLI_VERSION="12.0.0"                     # pinned by scripts/setup-mermaid.sh
MERMAID_CLI_PREFIX="$HOME/.local/share/mermaid-cli"
DIAGRAM_SIZE="1600"                              # long edge in CSS px
DIAGRAM_SCALE="2"                                # 2x so the 1.05 push-in stays sharp
DIAGRAM_BG="#0B1220"                             # must equal compose-video.mjs --bg (0x0B1220)
MMDC_CHROME=""                                  # empty = find system Chrome/Chromium

# ── demo tools (real evidence surfaces — see non-ui-evidence.md) ─────────────
# A hand-built results table, a styled HTML page or pretty-printed curl is NOT evidence.
# scripts/demo-tools.sh self-hosts these in the cage and records the URLs in
# $VIDEO_DIR/demo-tools.json; read them from there, do not hardcode ports.
DEMO_CB_PORT="8978"            # CloudBeaver  → DB rows / DDL / indexes
DEMO_HOPP_PORT="3300"          # Hoppscotch   → HTTP requests / payloads / auth failures
DEMO_HOPP_API_PORT="3170"      # Hoppscotch backend (GraphQL)
DEMO_API_BASE=""               # the run's own API, e.g. http://localhost:5173
DEMO_DB_URL=""                 # postgresql://user:pass@127.0.0.1:<port>/<db> — the RUN's DB
DEMO_REQUEST_SPEC=""           # "METHOD /path {json}" ;-separated → seeds the Hoppscotch import
DEMO_RUN_ENV="/tmp/workflow-run.env"

# ── capture ──────────────────────────────────────────────────────────────────
CAPTURE_VIEWPORT="1600x900"     # 1280x720 also proven; 1600x900 shows the whole app shell
CAPTURE_FPS="30"                # 10 was visibly steppy on scroll/panel animations
CAPTURE_QUALITY="80"            # AGENT_BROWSER_STREAM_QUALITY, daemon-wide
CAPTURE_SESSION="${CHROME_SESSION}"
CAPTURE_PROFILE="${CHROME_SESSION_PROFILE}"
LOGIN_EMAIL="owner@acme.com"    # local dev credentials; never a real account
LOGIN_PASSWORD="Password123!"
READY_TIMEOUT_MS="45000"

# ── narration ────────────────────────────────────────────────────────────────
TTS_BACKEND="qwen3"             # qwen3 | kokoro | piper
TTS_QWEN3_MODE="custom"         # custom (approved: preset speaker) | clone (frozen voice asset) | design (audition only)
TTS_QWEN3_SPEAKER="Aiden"       # the approved narrator; Ryan is rejected — do not re-introduce it
# custom holds ONE speaker embedding and still accepts a per-beat instruct, which is what
# makes per-beat delivery possible; design re-draws the speaker on every call, and clone
# accepts no instruct at all. Verify with voice-identity.py.
TTS_QWEN3_STABLE="1"            # reuse prompt, reseed per beat, runaway guard
# sampling — these values ARE the approved voice; 0.7 flattens the delivery (measured:
# pitch movement 148 Hz -> 85 Hz, which is what "sounds bored" measures as)
TTS_QWEN3_TEMPERATURE="0.9"
TTS_QWEN3_TOP_K="50"
TTS_QWEN3_REP_PENALTY="1.0"
# the frozen AU-engineer reference: used only by clone mode. Replace only by
# re-auditioning design mode, listening, then freezing the new take here (see steps/3).
TTS_REF_AUDIO="$SKILL/assets/voice/voice.wav"
TTS_REF_TEXT="$(cat ${SKILL:-$HOME/.agents/skills/workflow-video-tour}/assets/voice/voice.wav.txt)"
TTS_LOUDNESS="I=-16:TP=-1.5:LRA=11"   # every backend is normalised to this
# Empty keeps the preset's own timbre; the approved base voice text and the six per-beat
# clauses live in assets/voice/aiden-narration.md and ride on each timeline beat.
# A non-empty value colours every beat — that is how a new voice is auditioned (design).
TTS_INSTRUCT=""

# ── avatar ───────────────────────────────────────────────────────────────────
AVATAR_ENABLED="1"
AVATAR_MODE="svg"               # svg (default: the mascot) | pil (drawn person, needs a headshot) | none
AVATAR_BLINK="1"                # toggle the SVG's #eyes-open/#eyes-closed pair
AVATAR_BOB="3"                  # px of gentle vertical sway (0 = pinned)
AVATAR_DIR="$VIDEO_DIR/avatar"
AVATAR_SIZE="240"               # 240 proved readable at 1600x900; 300 for prominence
AVATAR_CORNER="br"
AVATAR_CAPTION_BAND="88"        # px reserved at the bottom for burned-in captions
AVATAR_FPS="30"                 # must match the video

# ── music (always on; licensing rules in steps/6-music.md) ───────────────────
MUSIC_FILE="$SKILL/assets/music/house.mp3"   # "" ships without a bed — say so in the PR body
MUSIC_BED_DB="-24"              # resting level relative to narration
MUSIC_DUCK="8"                  # sidechaincompress ratio; the narration is the trigger
MUSIC_ATTRIBUTION=""            # "Track — Artist · URL · Licence" → PR body when required

# ── attach ───────────────────────────────────────────────────────────────────
ATTACH_TO_PR="1"                # 1 = gh pr edit --attach, then move the block to the top of the body

# ── local model paths ────────────────────────────────────────────────────────
PIPER_BIN="$HOME/.local/share/piper/piper"
PIPER_VOICE_PATH="$HOME/.local/share/piper/voices/en_GB-alan-medium.onnx"
KOKORO_MODEL="$HOME/.local/share/kokoro/kokoro-v1.0.onnx"
KOKORO_VOICES="$HOME/.local/share/kokoro/voices-v1.0.bin"
QWEN3_ROOT="$HOME/.local/share/qwen3-tts"            # the 1.7B models + venv/
WHISPER_MODEL="$HOME/.local/share/voxtype/models/ggml-medium.en.bin"   # reference transcripts
RHUBARB=""                      # explicit rhubarb binary; empty = PATH / ~/.local/share
